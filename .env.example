# AI provider — OpenAI, single provider for everything (switched from Anthropic
# Claude: no Anthropic key available, and this consolidates to the provider
# already in use for embeddings since Spec 03). Covers:
#   - Generation/classification: lib/ai/client.ts (gpt-5.6-terra)
#   - Embeddings: scripts/ingest-kb.ts, lib/kb/search.ts (text-embedding-3-small,
#     1536 dims, matches kb_chunks.embedding vector(1536))
OPENAI_API_KEY=

# Supabase — SERVER-SIDE ONLY. Never import these outside app/api/* and lib/.
# There is no NEXT_PUBLIC_ Supabase key in this project — all DB access is server-mediated.
# SUPABASE_URL is the bare project URL (e.g. https://<ref>.supabase.co) — no
# /rest/v1/ or other path suffix; the Supabase client library appends that itself.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres access — only for running/verifying migrations (scripts, not
# read by the running app). Use the Session mode connection-pooler string from
# Supabase's dashboard (Project Settings -> Database -> Connection Pooling),
# not the direct db.*.supabase.co host — that host is IPv6-only and
# unreachable from some networks/sandboxes.
SUPABASE_DB_URL=

# Optional: gates a judge/admin debug view. Not a real auth system — a single shared value.
ADMIN_DEBUG_PASSWORD=

NODE_ENV=development
